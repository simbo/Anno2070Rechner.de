{
  "name": "anno2070rechner",
  "description": "Calculator and database for the game Anno 2070: population demands, commodity chains and buildings.",
  "version": "1.0.0",
  "private": true,
  "author": "Simon Lepel <simbo@simbo.de> (https://simbo.de)",
  "license": "MIT",
  "homepage": "https://anno2070rechner.de",
  "bugs": "https://github.com/simbo/Anno2070Rechner.de/issues",
  "repository": "github:simbo/Anno2070Rechner.de",
  "engines": {
    "node": "^24"
  },
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "scripts": {
    "build": "pnpm run check:types && vite build",
    "check": "pnpm run check:eslint && pnpm run check:format && pnpm run check:types && pnpm run check:spelling",
    "check:eslint": "eslint --config ./eslint.config.ts --max-warnings 0 .",
    "check:format": "prettier --check .",
    "check:spelling": "cspell",
    "check:types": "vue-tsc --build",
    "clean": "pnpm run clean:coverage && pnpm run clean:node_modules",
    "clean:coverage": "rm -rf coverage",
    "clean:node_modules": "rm -rf node_modules",
    "dev": "vite",
    "fix:eslint": "pnpm run check:eslint --fix",
    "fix:format": "prettier --write .",
    "images:check": "node scripts/images.ts check",
    "images:list": "node scripts/images.ts list",
    "ncu:latest": "ncu --interactive --target latest --reject='/^(@types/node)$/'",
    "ncu:minor": "ncu --interactive --target minor",
    "ncu:patch": "ncu --interactive --target patch",
    "preflight": "pnpm install --frozen-lockfile && pnpm run build && pnpm run test && pnpm run check && echo 'CvCfn6IgG1sxOzMybUFsbCBDaGVja3MgUGFzc2VkIRtbMG0K' | base64 --decode",
    "prepare": "husky",
    "preview": "vite preview",
    "start": "pnpm run dev",
    "test": "vitest run --coverage",
    "test:ui": "pnpm run test:watch --ui",
    "test:watch": "vitest dev --coverage"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@simbo/commitlint-config": "^2.0.1",
    "@simbo/cspell-config": "^2.1.1",
    "@simbo/eslint-config": "^3.2.1",
    "@simbo/prettier-config": "^3.0.1",
    "@simbo/tsconfig": "^2.0.0",
    "@simbo/vite-plugin-html-minifier": "^1.0.1",
    "@simbo/vite-plugin-nunjucks": "^1.0.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-legacy": "^8.2.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "cspell": "^10.4.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "npm-check-updates": "^23.1.1",
    "prettier": "3.9.10",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  }
}
