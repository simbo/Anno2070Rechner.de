{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["@vue/tsconfig/tsconfig.dom.json", "@simbo/tsconfig/browser"],
  "include": ["src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/*.test.ts", "src/tests/**"],
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true,
    "jsx": "preserve",
    "types": ["vite/client"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.browser.tsbuildinfo"
  }
}
